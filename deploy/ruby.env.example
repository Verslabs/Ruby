# Copy to /etc/ruby/ruby.env on the VPS (readable by root and the ruby user only).

# Where the Node server listens. Keep it on loopback; the web server proxies to it.
HOST=127.0.0.1
PORT=4000

# The blog's PostgreSQL database: posts, uploaded images, staff accounts and
# sessions. The tables are created on first use. Back this database up.
DATABASE_URL=postgres://ruby:CHANGE_ME@127.0.0.1:5432/ruby_blog
