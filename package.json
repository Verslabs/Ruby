{
  "name": "rubyportfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n site,blog -c magenta,cyan \"vite\" \"astro dev --root blog --ignore-lock\"",
    "dev:blog": "astro dev --root blog --ignore-lock",
    "build": "tsc -b && vite build && astro build --root blog",
    "start": "node server/index.mjs",
    "staff": "node --env-file-if-exists=blog/.env scripts/staff.mjs",
    "blog:import": "node --env-file-if-exists=blog/.env scripts/blog-import.mjs",
    "audio": "node scripts/make-audio.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "astro": "^7.4.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "marked": "^18.1.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
