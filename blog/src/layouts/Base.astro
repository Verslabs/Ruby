---
import '../styles/global.css'
import { blogUrl, siteUrl } from '../lib/urls'

interface Props {
  title: string
  description?: string
  /** keep the page out of search results (the editor) */
  noindex?: boolean
}

const { title, description = 'Writing by Ruby, full-stack developer and founder.', noindex = false } = Astro.props
const navLink = 'rounded-full px-3 py-1.5 text-white/60 transition-colors hover:text-white'
// lucide's speaker, shared by both states of the mute button
const speaker =
  'M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0714" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href={siteUrl('assets/vectors/mark.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="mx-auto flex max-w-3xl items-center justify-between px-5 py-6 md:py-8">
      <a href={siteUrl()} class="group flex items-center gap-3">
        <img
          src={siteUrl('assets/vectors/mark.png')}
          alt=""
          width="28"
          height="28"
          class="transition-transform duration-700 group-hover:rotate-[18deg]"
        />
        <span class="font-display text-lg font-bold tracking-tight text-white/90">Ruby</span>
      </a>
      <nav aria-label="Blog navigation" class="flex items-center gap-1 text-sm">
        <a href={blogUrl()} class={navLink}>Blog</a>
        <a href={siteUrl()} class={navLink}>Portfolio</a>
        <button
          type="button"
          data-sound-toggle
          aria-label="Turn sound on"
          aria-pressed="false"
          class="ml-1 flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/75 transition-colors duration-300 hover:border-white/35 hover:text-white"
        >
          <svg data-icon="on" hidden class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={speaker} /><path d="M16 9a5 5 0 0 1 0 6" /><path d="M19.364 18.364a9 9 0 0 0 0-12.728" />
          </svg>
          <svg data-icon="off" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={speaker} /><line x1="22" x2="16" y1="9" y2="15" /><line x1="16" x2="22" y1="9" y2="15" />
          </svg>
        </button>
      </nav>
    </header>

    <main class="mx-auto max-w-3xl px-5 pb-24">
      <slot />
    </main>

    <footer class="mx-auto flex max-w-3xl items-center justify-between px-5 pb-10 text-sm text-white/35">
      <span>© {new Date().getFullYear()} Ruby</span>
      <a href={blogUrl('write/')} rel="nofollow" class="transition-colors hover:text-white/70">Staff</a>
    </footer>

    <script>
      import '../scripts/sound'
      import '../scripts/secret'
    </script>
  </body>
</html>
